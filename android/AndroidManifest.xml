<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="de.mermaideditor">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <application android:label="Mermaid Editor" android:icon="@drawable/app_icon"
        android:theme="@style/AppTheme" android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules" android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name=".ClipboardImageProvider"
            android:authorities="de.mermaideditor.clipboard" android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
